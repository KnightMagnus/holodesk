  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "src/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/unit/*.test.js\"",
